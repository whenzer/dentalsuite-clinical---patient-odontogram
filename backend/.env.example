# ==============================================================================
# DentalSuite Backend Environment Variables
# Copy this file to .env and supply your credentials before starting
# ==============================================================================

# Application Port (3000 for local dev, 8080 on Fly.io)
PORT=3000
NODE_ENV=development

# Allowed CORS Origins (Frontend URL, e.g. http://localhost:3000 or your Vercel/Fly URL)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://your-frontend-app.fly.dev

# ==============================================================================
# Database Configuration (Supabase PostgreSQL)
# ==============================================================================
# Option 1: Supabase Direct/Pooled Connection URI (Recommended)
# Go to your Supabase Project -> Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Or direct connection on port 5432:
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_SUPABASE_REF.supabase.co:5432/postgres

# Option 2: Individual Database Connection Parameters (used if DATABASE_URL is not set)
DB_HOST=db.YOUR_SUPABASE_REF.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
DB_NAME=postgres
# SSL is mandatory for Supabase connections
DB_SSL=true
DB_REJECT_UNAUTHORIZED=false

# TypeORM Auto Schema Sync (true in development to create tables automatically, false in production)
TYPEORM_SYNCHRONIZE=true
TYPEORM_LOGGING=false

# Auto-seed initial clinic master data on empty database
AUTO_SEED_DATA=true

# ==============================================================================
# Authentication & Security (JSON Web Token & Refresh Token)
# ==============================================================================
# 15-Minute Access Token Secret & Expiry
JWT_ACCESS_SECRET=super_secret_clinical_access_jwt_key_32chars_min_replace_in_prod!
JWT_ACCESS_EXPIRES_IN=15m

# 7-Day Refresh Token Secret & Expiry
JWT_REFRESH_SECRET=super_secret_clinical_refresh_jwt_key_32chars_min_replace_in_prod!
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt Salt Rounds for Password Hashing (10-12 is industry corporate standard)
BCRYPT_SALT_ROUNDS=10

# ==============================================================================
# Real-Time WebSocket Configuration
# ==============================================================================
WS_PORT=3000
WS_PATH=/socket.io
